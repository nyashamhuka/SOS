{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tsconfig.schema.json",
  "type": "object",
  "properties": {
    "compilerOptions": {
      "type": "object"
    },
    "include": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
